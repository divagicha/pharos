    {"name": "clouds", "module": "body", "vs": "vs_body", "fs": "fs_clouds", "groups": ["globals", "body"], "depth": "test", "blend": "premul", "msaa": true},
    {"name": "atmo", "module": "body", "vs": "vs_body", "fs": "fs_atmo", "groups": ["globals", "body"], "depth": "test", "blend": "dsb", "msaa": true},
    {"name": "ring", "module": "body", "vs": "vs_ring", "fs": "fs_ring", "groups": ["globals", "body"], "depth": "test", "blend": "premul", "msaa": true},
    {"name": "corona", "module": "body", "vs": "vs_body", "fs": "fs_corona", "groups": ["globals", "body", "loops"], "depth": "test", "blend": "premul", "msaa": true},
    {"name": "rocks", "module": "field", "vs": "vs_rock", "fs": "fs_rock", "groups": ["globals", "zone"], "depth": "write", "msaa": true, "topology": "triangle-list", "buffers": [{"arrayStride": 12, "attributes": [{"shaderLocation": 0, "offset": 0, "format": "float32x3"}]},{"arrayStride": 32, "stepMode": "instance", "attributes": [{"shaderLocation": 1, "offset": 0, "format": "float32x4"},{"shaderLocation": 2, "offset": 16, "format": "float32x4"}]}]},
    {"name": "rocks_far", "module": "field", "vs": "vs_rockfar", "fs": "fs_rockfar", "groups": ["globals", "zone"], "depth": "test", "blend": "add", "msaa": true, "buffers": [{"arrayStride": 32, "stepMode": "instance", "attributes": [{"shaderLocation": 1, "offset": 0, "format": "float32x4"},{"shaderLocation": 2, "offset": 16, "format": "float32x4"}]}]},
    {"name": "dustA", "module": "field", "vs": "vs_dustA", "fs": "fs_dust", "groups": ["globals", "zone"], "depth": "test", "blend": "add", "msaa": true, "buffers": [{"arrayStride": 16, "stepMode": "instance", "attributes": [{"shaderLocation": 0, "offset": 0, "format": "float32x4"}]}]},
